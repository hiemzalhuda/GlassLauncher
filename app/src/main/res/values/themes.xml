<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque window: the launcher draws its own wallpaper background
         (the same bitmap the glass blur crops from), so the window no
         longer relies on the system wallpaper showing through. -->
    <style name="Theme.GlassLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
